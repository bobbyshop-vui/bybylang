#version 450
// 1:1 mirror of attention_fused_backward_kernel (backends/metal/kernels/
// vecop_matmul.metal) - SAME steps, formulas and loop order
// as the Metal version; only the float atomic add differs: Metal uses
// atomic_uint + as_type<float>/as_type<uint> (bitcasts), GLSL/Vulkan
// core has no built-in float atomics (GL_EXT_shader_atomic_float is not
// used, for compatibility with more drivers), so
// the SAME CAS-loop algorithm runs through atomicCompSwap on a
// uint buffer + floatBitsToUint/uintBitsToFloat.
//
// Dispatch: 1 thread / (bh, ti), local_size=(1,1,1), groupCount=(B*H,S,1)
// - SAME as Metal [encoder dispatchThreads:gridSize=(B*H,S,1)
// threadsPerThreadgroup:(1,1,1)] (no threadgroup/shared memory,
// exactly like the Metal version).
//
// LIMIT: S <= 256 (local arrays softmaxW[256]/dSoftmax[256] - same
// limit and reason as metal_attention_fused_backward: S>256 would read/write
// past the local arrays. The caller (vulkanAttentionFusedBackward) MUST check
// S<=256 before dispatching, exactly like metal_shim.m).
layout(local_size_x = 1, local_size_y = 1) in;
layout(std430, binding = 0) readonly buffer BufQ  { float q[]; };
layout(std430, binding = 1) readonly buffer BufK  { float k[]; };
layout(std430, binding = 2) readonly buffer BufV  { float v[]; };
layout(std430, binding = 3) readonly buffer BufS  { float s_matrix[]; };
layout(std430, binding = 4) readonly buffer BufDy { float dy[]; };
layout(std430, binding = 5) buffer BufDq { float dq[]; };  // each thread writes only its own row ti -> no atomics
layout(std430, binding = 6) buffer BufDk { uint  dk[]; };  // atomic CAS float via bitcast (see atomicAddDk)
layout(std430, binding = 7) buffer BufDv { uint  dv[]; };  // atomic CAS float via bitcast (see atomicAddDv)
layout(push_constant) uniform PC { int B; int H; int S; int D; float scale; } pc;

// Mirror of atomicAddFloatDevice (Metal) for the dk[] buffer - CAS loop: read the
// current value (a float bit pattern), add val, write it back with
// atomicCompSwap; if another thread wrote first (prev !=
// expected), take that NEW value as expected and retry - same as the
// while loop of the Metal version.
void atomicAddDk(uint idx, float val) {
    uint expected = dk[idx];
    while (true) {
        float expectedF = uintBitsToFloat(expected);
        uint desired = floatBitsToUint(expectedF + val);
        uint prev = atomicCompSwap(dk[idx], expected, desired);
        if (prev == expected) break;
        expected = prev;
    }
}

void atomicAddDv(uint idx, float val) {
    uint expected = dv[idx];
    while (true) {
        float expectedF = uintBitsToFloat(expected);
        uint desired = floatBitsToUint(expectedF + val);
        uint prev = atomicCompSwap(dv[idx], expected, desired);
        if (prev == expected) break;
        expected = prev;
    }
}

void main() {
    uint bh = gl_GlobalInvocationID.x;
    uint ti = gl_GlobalInvocationID.y;
    if (bh >= uint(pc.B * pc.H) || ti >= uint(pc.S)) return;

    uint base_idx = bh * uint(pc.S) * uint(pc.D);
    uint base_s   = bh * uint(pc.S) * uint(pc.S);

    // softmaxW[tj] = s_matrix[bh, ti, tj] cho tj=0..ti (mirror dong 1284-1287 Metal)
    float softmaxW[256];
    for (uint tj = 0u; tj <= ti; ++tj) {
        softmaxW[tj] = s_matrix[base_s + ti * uint(pc.S) + tj];
    }

    // dv[tj,d] += softmaxW[tj] * dy[ti,d] (atomic, several ti write the same tj) and
    // dSoftmax[tj] = sum_d dy[ti,d] * v[tj,d] (mirrors Metal lines 1289-1298)
    float dSoftmax[256];
    for (uint tj = 0u; tj <= ti; ++tj) {
        float dotVal = 0.0;
        for (int d = 0; d < pc.D; ++d) {
            float dyVal = dy[base_idx + ti * uint(pc.D) + uint(d)];
            atomicAddDv(base_idx + tj * uint(pc.D) + uint(d), softmaxW[tj] * dyVal);
            dotVal += dyVal * v[base_idx + tj * uint(pc.D) + uint(d)];
        }
        dSoftmax[tj] = dotVal;
    }

    // dotSum = sum_tj softmaxW[tj] * dSoftmax[tj] (Jacobian softmax, mirror dong 1300-1303 Metal)
    float dotSum = 0.0;
    for (uint tj = 0u; tj <= ti; ++tj) {
        dotSum += softmaxW[tj] * dSoftmax[tj];
    }

    // dScore = softmaxW[tj] * (dSoftmax[tj] - dotSum) * scale; then dq (no atomic,
    // this row ti only) and dk (atomic, several ti write the same tj) - mirrors Metal lines 1305-1311
    for (uint tj = 0u; tj <= ti; ++tj) {
        float dScore = softmaxW[tj] * (dSoftmax[tj] - dotSum) * pc.scale;
        for (int d = 0; d < pc.D; ++d) {
            dq[base_idx + ti * uint(pc.D) + uint(d)] += dScore * k[base_idx + tj * uint(pc.D) + uint(d)];
            atomicAddDk(base_idx + tj * uint(pc.D) + uint(d), dScore * q[base_idx + ti * uint(pc.D) + uint(d)]);
        }
    }
}
