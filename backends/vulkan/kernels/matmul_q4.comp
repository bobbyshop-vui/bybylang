#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

// matmul_q4.comp - mirrors 100% of the techniques MEASURED on Metal
// (matmul_q4_kernel_ndst2_paired in vecop_matmul.metal, fully explained
// there): NDST 8 -> 2 (less register/shared-memory pressure on weak
// Intel Gen9 GPUs - measured on Iris Plus 640: decode 0.86->1.01 tok/s,
// prefill 1.6->2.15 tok/s) + nibbles read IN PAIRS (k2,k2+1) with one
// uint8_t read + plain bitmasks, no runtime (k&1)==0 branch at all.
//
// NOT YET RUN ON A REAL VULKAN GPU (no Vulkan machine to test on when
// this was written) - measure it before using it for real token generation.
// If it is wrong/slower, the old version (NDST=8, no pairing) is still in
// git history and can be restored right away.
//
// FIXED A REAL BUG FOUND ALONG THE WAY (it predates and is UNRELATED to
// the NDST/pairing change): local_size_x=128 but the old k loop
// hardcoded "k += 32" - lane 32 started at k=32 with step 32, EXACTLY
// overlapping lane 0 on its SECOND iteration (k=32) - k=32 was ADDED
// TWICE (once into sdata[rr][0], once into sdata[rr][32]) and the tree
// reduction added both slots -> WRONG RESULTS (double counted), not a
// crash, so easy to miss when checking by eye (only numerically wrong,
// "plausible" text with wrong logits). FIX: "k += 32" became
// "k += WG_SIZE" (128, the real local_size_x) - every lane in the
// workgroup now covers its OWN set of k, no more overlap.
//
// Bien dich: glslangValidator -V matmul_q4.comp -o matmul_q4.spv
//        hoac: glslc matmul_q4.comp -o matmul_q4.spv

#define MMQ4_NDST 2
// CHANGED: 8 -> 2 (mirrors ggml's N_R0_Q4_K=2 + the Metal measurements -
// fully explained in vecop_matmul.metal). MUST match
// const MMQ4_NDST in vulkan_driver.nim (the two must agree,
// otherwise rowBlocks are dispatched wrong).

#define WG_SIZE 128
layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA     { float a[]; };        // [M,K]
layout(std430, binding = 1) readonly buffer BufWq    { uint8_t wq[]; };     // packed nibble [N, ceil(K/2)]
layout(std430, binding = 2) readonly buffer BufScale { float scales[]; };   // [N * nGroupsPerRow]
layout(std430, binding = 3) readonly buffer BufZero  { float zeros[]; };    // [N * nGroupsPerRow]
layout(std430, binding = 4) writeonly buffer BufC    { float c[]; };        // [M,N]

layout(push_constant) uniform PushConsts {
    int M;
    int K;
    int N;
    int groupSize;
    int nGroupsPerRow;
    int wqOff;          // byte position of the packed weights inside wq
} pc;

// shared memory for the tree reduction - small NDST (2) -> this array is now TINY
// (2*128*4 bytes = 1KB vs 8*128*4=4KB before) - same "less on-chip
// memory pressure" idea as the Metal change (registers there, shared
// memory here, same principle: smaller NDST -> fewer on-chip
// resources per workgroup -> better occupancy on weak GPUs).
shared float sdata[MMQ4_NDST][WG_SIZE];

void main() {
    // gl_WorkGroupID.x = rowBlock, gl_WorkGroupID.y = m (mirror tgpig.x/tgpig.y ben Metal)
    int m = int(gl_WorkGroupID.y);
    if (m >= pc.M) return;
    int rowBlock = int(gl_WorkGroupID.x);
    uint lid = gl_LocalInvocationID.x;   // 0..WG_SIZE-1, unique within the whole workgroup

    int bytesPerRow = (pc.K + 1) / 2;
    int n0 = rowBlock * MMQ4_NDST;
    int rowByteOff[MMQ4_NDST];
    int rowGroupOff[MMQ4_NDST];
    float partial[MMQ4_NDST];
    for (int rr = 0; rr < MMQ4_NDST; ++rr) {
        int n = n0 + rr;
        rowByteOff[rr] = pc.wqOff + n * bytesPerRow;
        rowGroupOff[rr] = n * pc.nGroupsPerRow;
        partial[rr] = 0.0;
    }

    int curGroup[MMQ4_NDST];
    float scCache[MMQ4_NDST];
    float zpCache[MMQ4_NDST];
    for (int rr = 0; rr < MMQ4_NDST; ++rr) curGroup[rr] = -1;

    // groupSize is assumed EVEN (true for the usual 32/64/128/256) so k2
    // and k2+1 are always in the same group - see the Metal version for details.
    for (int k2 = int(lid) * 2; k2 < pc.K; k2 += WG_SIZE * 2) {
        float aVal0 = a[m * pc.K + k2];
        bool hasK1 = (k2 + 1) < pc.K;
        float aVal1 = hasK1 ? a[m * pc.K + k2 + 1] : 0.0;
        int g = pc.groupSize > 0 ? (k2 / pc.groupSize) : 0;
        int byteIdx = k2 >> 1;

        for (int rr = 0; rr < MMQ4_NDST; ++rr) {
            int n = n0 + rr;
            if (n >= pc.N) continue;
            if (g != curGroup[rr]) {
                curGroup[rr] = g;
                scCache[rr] = scales[rowGroupOff[rr] + g];
                zpCache[rr] = zeros[rowGroupOff[rr] + g];
            }
            uint8_t byteVal = wq[rowByteOff[rr] + byteIdx];
            uint nib0 = uint(byteVal) & 0x0Fu;          // k2 (chan)  -> nibble thap
            uint nib1 = (uint(byteVal) >> 4) & 0x0Fu;   // k2+1 (le)  -> nibble cao
            partial[rr] += aVal0 * ((float(nib0) - zpCache[rr]) * scCache[rr]);
            if (hasK1) partial[rr] += aVal1 * ((float(nib1) - zpCache[rr]) * scCache[rr]);
        }
    }

    for (int rr = 0; rr < MMQ4_NDST; ++rr) {
        sdata[rr][lid] = partial[rr];
    }
    barrier();
    // Standard tree reduction over all WG_SIZE threads of the WORKGROUP -
    // correct for EVERY hardware subgroup size (no reliance on
    // subgroupAdd/gl_SubgroupInvocationID - see the top of the file).
    for (uint stride = uint(WG_SIZE) / 2u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            for (int rr = 0; rr < MMQ4_NDST; ++rr) {
                sdata[rr][lid] += sdata[rr][lid + stride];
            }
        }
        barrier();
    }
    if (lid == 0u) {
        for (int rr = 0; rr < MMQ4_NDST; ++rr) {
            int n = n0 + rr;
            if (n < pc.N) {
                c[m * pc.N + n] = sdata[rr][0];
            }
        }
    }
}
