#version 450
// Dropout mask generated on the GPU with a counter-based xorshift32, same
// formula as dropout_mask in dropout_rng_kernel.cu (CUDA) so both backends give
// the same statistical distribution (not necessarily bit-for-bit, the seed is
// derived differently at runtime, but the algorithm is the same).
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer BufMask { float mask[]; };
layout(push_constant) uniform PC { uint seed; float p; float scale; int n; } pc;

uint xorshift32(uint x) {
    x ^= x << 13u;
    x ^= x >> 17u;
    x ^= x << 5u;
    return x;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.n)) return;
    uint state = pc.seed ^ (id * 2654435761u + 1u);
    state = xorshift32(state);
    state = xorshift32(state);
    float u = float(state >> 8u) * (1.0 / 16777216.0);
    mask[id] = (u < pc.p) ? 0.0 : pc.scale;
}
