#version 450
// APFLU derivative: x>0 -> dy*(1+2*alpha*x); x<=0 -> dy*beta*exp(x)*(1+x).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufDy { float dy[]; };
layout(std430, binding = 2) writeonly buffer BufDx { float dx[]; };
layout(push_constant) uniform PC { float alpha; float beta; int n; } pc;
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.n)) return;
    float v = x[id];
    dx[id] = v > 0.0 ? dy[id] * (1.0 + 2.0 * pc.alpha * v) : dy[id] * pc.beta * exp(v) * (1.0 + v);
}
