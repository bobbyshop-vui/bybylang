#version 450
// Mirror of softmax_kernel (vecop_matmul.metal) - shared-memory reduction
// + barrier (NO subgroups - this reduces over the whole 256-thread workgroup,
// unlike matmul_q4 which needs only one 32-thread subgroup).
#define BB_WG 256
layout(local_size_x = BB_WG) in;
layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) writeonly buffer BufY { float y[]; };
layout(push_constant) uniform PC { int cols; } pc;

shared float red[BB_WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint off = row * uint(pc.cols);

    float m = -1.0 / 0.0; // -infinity
    for (int c = int(tid); c < pc.cols; c += BB_WG) {
        m = max(m, x[off + c]);
    }
    red[tid] = m;
    barrier();
    for (uint s = BB_WG / 2u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] = max(red[tid], red[tid + s]);
        barrier();
    }
    float maxVal = red[0];
    barrier();

    float sum = 0.0;
    for (int c = int(tid); c < pc.cols; c += BB_WG) {
        float e = exp(x[off + c] - maxVal);
        y[off + c] = e;
        sum += e;
    }
    red[tid] = sum;
    barrier();
    for (uint s = BB_WG / 2u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float invSum = 1.0 / red[0];
    barrier();

    for (int c = int(tid); c < pc.cols; c += BB_WG) {
        y[off + c] *= invSum;
    }
}
