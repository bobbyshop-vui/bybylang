#version 450
// matmul_gemv.comp - GEMV for m=1 (mirror of matmul_gemv_kernel on Metal).
// FIXED BUG: the previous version used subgroupAdd() and assumed a subgroup
// size of 32 (true for Apple GPUs through Metal simdgroups, WRONG on
// Intel Iris Plus through Vulkan/MoltenVK, where the native Gen9 SIMD width is
// 8 or 16, not 32). With a real subgroup < 32 a 32-thread workgroup
// is split into SEVERAL subgroups, each with its own
// gl_SubgroupInvocationID==0 -> SEVERAL threads overwrote c[col]
// (race condition) and each subgroup summed only part of K -> WRONG results
// (the cause of the "!!!!" garbage tokens seen only on Vulkan, never
// on Metal). Fix: no subgroupAdd and no hardware assumption -
// shared memory + a tree reduction over local_size_x (32), correct
// whatever subgroup size the hardware reports.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer BufA { float a[]; };  // [K]
layout(std430, binding = 1) readonly buffer BufB { float b[]; };  // [K,N]
layout(std430, binding = 2) writeonly buffer BufC { float c[]; }; // [N]
layout(push_constant) uniform PC { int M; int K; int N; } pc;

shared float sdata[32];

void main() {
    int col = int(gl_WorkGroupID.x);
    uint lid = gl_LocalInvocationID.x;   // 0..31, ALWAYS unique within the workgroup
    float sum = 0.0;
    if (col < pc.N) {
        for (int i = int(lid); i < pc.K; i += 32) {
            sum += a[i] * b[i * pc.N + col];
        }
    }
    sdata[lid] = sum;
    barrier();
    // Tree reduction in shared memory - correct for EVERY hardware
    // subgroup size because it no longer relies on subgroupAdd.
    for (uint stride = 16u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            sdata[lid] += sdata[lid + stride];
        }
        barrier();
    }
    if (lid == 0u && col < pc.N) {
        c[col] = sdata[0];
    }
}
