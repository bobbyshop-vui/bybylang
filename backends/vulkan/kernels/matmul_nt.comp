#version 450
// matmul_nt.comp - variant of matmul.comp: C(M x N) = A(M x K) @ B(N x K)^T.
// B KEEPS its original [N,K] layout (e.g. the natural K-cache/V-cache [S,D]) - NO
// transpose before upload. Same 16x16 tile + shared-memory algorithm
// as matmul.comp, only B is indexed differently (by row instead of column).

#define TILE 16
layout(local_size_x = TILE, local_size_y = TILE) in;
layout(std430, binding = 0) readonly buffer BufA { float a[]; };  // [M,K]
layout(std430, binding = 1) readonly buffer BufB { float b[]; };  // [N,K] (NOT [K,N])
layout(std430, binding = 2) writeonly buffer BufC { float c[]; }; // [M,N]
// bOff: element offset of B inside its buffer (a weight wrapped in place
// inside a model mmap starts after the page boundary).
layout(push_constant) uniform PC { int M; int K; int N; int bOff; } pc;

shared float tileA[TILE][TILE];
shared float tileB[TILE][TILE];

void main() {
    uint row = gl_GlobalInvocationID.y;  // M index (A) / also the row of C
    uint col = gl_GlobalInvocationID.x;  // N index (B) / also the column of C
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    float acc = 0.0;
    int numTiles = (pc.K + TILE - 1) / TILE;
    for (int t = 0; t < numTiles; ++t) {
        int aCol = t * TILE + int(tx);   // K index for A
        int bCol = t * TILE + int(ty);   // K index for B (B is [N,K], so K is the column)
        tileA[ty][tx] = (row < uint(pc.M) && aCol < pc.K) ? a[row * uint(pc.K) + uint(aCol)] : 0.0;
        // B[N,K]: row = col (N index), column = bCol (K index)
        tileB[ty][tx] = (col < uint(pc.N) && bCol < pc.K) ? b[uint(pc.bOff) + col * uint(pc.K) + uint(bCol)] : 0.0;
        barrier();
        for (int kk = 0; kk < TILE; ++kk) {
            // tileA[ty][kk] = A[row, t*TILE+kk] ; tileB[kk][tx] = B[col, t*TILE+kk]
            // (tileB is loaded with row=ty=K-column, so it is read back in the right direction)
            acc += tileA[ty][kk] * tileB[kk][tx];
        }
        barrier();
    }
    if (row < uint(pc.M) && col < uint(pc.N)) {
        c[row * uint(pc.N) + col] = acc;
    }
}
