#version 450
// Mirror rmsnorm_kernel (vecop_matmul.metal) - cùng cơ chế reduction với
// softmax.comp (đã proven cùng pattern), chỉ khác công thức cuối.
#define BB_WG 256
layout(local_size_x = BB_WG) in;
layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufGamma { float gamma[]; };
layout(std430, binding = 2) writeonly buffer BufY { float y[]; };
layout(push_constant) uniform PC { int cols; float eps; } pc;

shared float red[BB_WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint off = row * uint(pc.cols);

    float sumSq = 0.0;
    for (int c = int(tid); c < pc.cols; c += BB_WG) {
        float v = x[off + c];
        sumSq += v * v;
    }
    red[tid] = sumSq;
    barrier();
    for (uint s = BB_WG / 2u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float meanSq = red[0] / float(pc.cols);
    float invStd = 1.0 / sqrt(meanSq + pc.eps);
    barrier();

    for (int c = int(tid); c < pc.cols; c += BB_WG) {
        y[off + c] = x[off + c] * invStd * gamma[c];
    }
}
