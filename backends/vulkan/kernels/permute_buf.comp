#version 450
// Strided permute whose stride tables live in (already uploaded) int buffers,
// like the Metal session permute; the push-constant variant is permute.comp.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer BufSrc { float src[]; };
layout(std430, binding = 1) readonly buffer BufNew { int newStrides[]; };
layout(std430, binding = 2) readonly buffer BufOld { int oldStrides[]; };
layout(std430, binding = 3) readonly buffer BufMap { int dimsMap[]; };
layout(std430, binding = 4) writeonly buffer BufDst { float dst[]; };
layout(push_constant) uniform PC { int ndim; int n; } pc;
void main() {
    uint linear = gl_GlobalInvocationID.x;
    if (linear >= uint(pc.n)) return;
    int rem = int(linear);
    int oldLinear = 0;
    for (int i = 0; i < pc.ndim; i++) {
        int idxI = rem / newStrides[i];
        rem = rem % newStrides[i];
        oldLinear += idxI * oldStrides[dimsMap[i]];
    }
    dst[linear] = src[oldLinear];
}
