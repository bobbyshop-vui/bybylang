#version 450
// One invocation per row: dx = invStd*(dy*g - mean(dy*g) - xhat*mean(dy*g*xhat)).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer BufDy { float dy[]; };
layout(std430, binding = 1) readonly buffer BufX { float x[]; };
layout(std430, binding = 2) readonly buffer BufG { float gamma[]; };
layout(std430, binding = 3) readonly buffer BufStats { float stats[]; };
layout(std430, binding = 4) writeonly buffer BufDx { float dx[]; };
layout(push_constant) uniform PC { int rows; int cols; } pc;
void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= uint(pc.rows)) return;
    int base = int(r) * pc.cols;
    float mean = stats[2 * r], inv = stats[2 * r + 1];
    float s1 = 0.0, s2 = 0.0;
    for (int c = 0; c < pc.cols; c++) {
        float xh = (x[base + c] - mean) * inv;
        float dyg = dy[base + c] * gamma[c];
        s1 += dyg; s2 += dyg * xh;
    }
    for (int c = 0; c < pc.cols; c++) {
        float xh = (x[base + c] - mean) * inv;
        float dyg = dy[base + c] * gamma[c];
        dx[base + c] = inv * (dyg - s1 / float(pc.cols) - xh * s2 / float(pc.cols));
    }
}
