#version 450
// attention_decode_gqa.comp - EXACT GLSL mirror of attention_decode_gqa_kernel.cu
// (backends/cuda/kernels/attention_decode_gqa_kernel.cu, v2). The SAME
// 3-step algorithm (max -> exp/sum -> weighted-sum output) with shared
// memory + tree reduction, no other algorithm invented.
//
//   q: [H, D]      - H query heads of one GQA group
//   k, v: [S, D]   - shared by all H heads (one GQA KV-head pair)
//   o: [H, D]      - attention output per query head
//   scores: [H, S] - scratch buffer
//
// Dispatch convention (MUST match vulkanSessionAttentionDecodeGqaEnc):
//   groupCount = (H, 1, 1)   -- 1 workgroup / query head
//   local_size_x = 128       -- matches ATTN_DECODE_TG on CUDA/Metal/OpenCL
//
// WARNING (mirrored verbatim from the CUDA version): the original kernel HAD NOT
// RUN ON REAL HARDWARE when written - verify with BYBY_VERIFY_ATTN_DECODE=1 (see
// nim_inference.nim) before trusting its results on a real machine.

#define ATTN_DECODE_TG 128

layout(local_size_x = ATTN_DECODE_TG) in;

layout(std430, binding = 0) readonly buffer BufQ      { float q[]; };       // [H,D]
layout(std430, binding = 1) readonly buffer BufK      { float k[]; };       // [S,D]
layout(std430, binding = 2) readonly buffer BufV      { float v[]; };       // [S,D]
layout(std430, binding = 3) writeonly buffer BufO     { float o[]; };       // [H,D]
layout(std430, binding = 4) buffer BufScores          { float scores[]; };  // [H,S] scratch

layout(push_constant) uniform PC {
    int H;
    int S;
    int D;
    float scale;
} pc;

shared float sharedReduce[ATTN_DECODE_TG];

void main() {
    int h = int(gl_WorkGroupID.x);
    int tid = int(gl_LocalInvocationID.x);
    if (h >= pc.H) return;

    int qBase = h * pc.D;
    int sBase = h * pc.S;

    // Step 1: dot(q_h, k_tj) for the tj owned by this thread + local max
    float localMax = -1e30;
    for (int tj = tid; tj < pc.S; tj += ATTN_DECODE_TG) {
        float dotv = 0.0;
        int kBase = tj * pc.D;
        for (int d = 0; d < pc.D; ++d) {
            dotv += q[qBase + d] * k[kBase + d];
        }
        float sc = dotv * pc.scale;
        scores[sBase + tj] = sc;
        if (sc > localMax) localMax = sc;
    }
    sharedReduce[tid] = localMax;
    barrier();
    for (int stride = ATTN_DECODE_TG / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            sharedReduce[tid] = max(sharedReduce[tid], sharedReduce[tid + stride]);
        }
        barrier();
    }
    float mx = sharedReduce[0];
    barrier();

    // Step 2: exp(score-mx) + local sum, tree reduction for the total
    float localSum = 0.0;
    for (int tj = tid; tj < pc.S; tj += ATTN_DECODE_TG) {
        float e = exp(scores[sBase + tj] - mx);
        scores[sBase + tj] = e;
        localSum += e;
    }
    sharedReduce[tid] = localSum;
    barrier();
    for (int stride = ATTN_DECODE_TG / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            sharedReduce[tid] += sharedReduce[tid + stride];
        }
        barrier();
    }
    float invSum = 1.0 / sharedReduce[0];
    barrier();

    // Step 3: output - D split across threads, each thread loops over S.
    for (int d = tid; d < pc.D; d += ATTN_DECODE_TG) {
        float acc = 0.0;
        for (int tj = 0; tj < pc.S; ++tj) {
            acc += scores[sBase + tj] * v[tj * pc.D + d];
        }
        o[qBase + d] = acc * invSum;
    }
}
