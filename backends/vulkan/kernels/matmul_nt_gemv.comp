#version 450
// matmul_nt_gemv.comp - GEMV for m=1 with B in [N,K] layout (the natural
// resident K/V-cache layout), read by rows. No subgroupAdd (see matmul_gemv.comp:
// the real subgroup size on Intel Iris Plus can be 8/16, not 32, and assuming 32
// caused a race condition -> garbage tokens). Shared-memory reduction works on
// every GPU.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer BufA { float a[]; };  // [K]
layout(std430, binding = 1) readonly buffer BufB { float b[]; };  // [N,K]
layout(std430, binding = 2) writeonly buffer BufC { float c[]; }; // [N]
// bOff: element offset of B inside its buffer (a weight wrapped in place
// inside a model mmap starts after the page boundary).
layout(push_constant) uniform PC { int M; int K; int N; int bOff; } pc;

shared float sdata[32];

void main() {
    int row = int(gl_WorkGroupID.x);
    uint lid = gl_LocalInvocationID.x;
    float sum = 0.0;
    if (row < pc.N) {
        int base = pc.bOff + row * pc.K;
        for (int i = int(lid); i < pc.K; i += 32) {
            sum += a[i] * b[base + i];
        }
    }
    sdata[lid] = sum;
    barrier();
    for (uint stride = 16u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            sdata[lid] += sdata[lid + stride];
        }
        barrier();
    }
    if (lid == 0u && row < pc.N) {
        c[row] = sdata[0];
    }
}
