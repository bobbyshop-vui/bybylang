#version 450
// matmul_nt_gemv.comp - GEMV cho m=1, B layout [N,K] (K/V-cache resident
// tu nhien) - doc theo hang. SUA: bo subgroupAdd (xem giai thich chi tiet
// trong matmul_gemv.comp - Intel Iris Plus subgroup size thuc te co the
// la 8/16, khong phai 32, subgroupAdd gia dinh sai gay race condition ->
// token rac). Dung shared memory reduction, dung voi moi phan cung.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer BufA { float a[]; };  // [K]
layout(std430, binding = 1) readonly buffer BufB { float b[]; };  // [N,K]
layout(std430, binding = 2) writeonly buffer BufC { float c[]; }; // [N]
// bOff: element offset of B inside its buffer (a weight wrapped in place
// inside a model mmap starts after the page boundary).
layout(push_constant) uniform PC { int M; int K; int N; int bOff; } pc;

shared float sdata[32];

void main() {
    int row = int(gl_WorkGroupID.x);
    uint lid = gl_LocalInvocationID.x;
    float sum = 0.0;
    if (row < pc.N) {
        int base = pc.bOff + row * pc.K;
        for (int i = int(lid); i < pc.K; i += 32) {
            sum += a[i] * b[base + i];
        }
    }
    sdata[lid] = sum;
    barrier();
    for (uint stride = 16u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            sdata[lid] += sdata[lid + stride];
        }
        barrier();
    }
    if (lid == 0u && row < pc.N) {
        c[row] = sdata[0];
    }
}
